// Генерируется CMake (configure_file) из app.rc.in → build/app.rc.
// Путь к иконке АБСОЛЮТНЫЙ и с прямыми слэшами, чтобы windres гарантированно нашёл
// файл независимо от рабочей директории (в .rc обратный слэш — это escape!).
#include <windows.h>

IDI_ICON1 ICON "@RPOVERLAY_ICON_ABS@"

// VERSIONINFO (Слой A5 плана усиления): заполненные метаданные издателя/версии снижают AV
// false-positive — особенно важно для упакованного Themida бинаря (пустые метаданные = повод для FP).
VS_VERSION_INFO VERSIONINFO
 FILEVERSION    @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 PRODUCTVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 FILEFLAGSMASK  0x3fL
 FILEFLAGS      0x0L
 FILEOS         VOS_NT_WINDOWS32
 FILETYPE       VFT_APP
 FILESUBTYPE    VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "TurgovBot"
            VALUE "FileDescription",  "RP Overlay"
            VALUE "FileVersion",      "@PROJECT_VERSION@.0"
            VALUE "InternalName",     "RpOverlay"
            VALUE "OriginalFilename", "RpOverlay.exe"
            VALUE "ProductName",      "RP Overlay"
            VALUE "ProductVersion",   "@PROJECT_VERSION@"
            VALUE "LegalCopyright",   "Copyright (C) 2026 TurgovBot"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
