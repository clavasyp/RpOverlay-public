// Генерируется CMake (configure_file) из updater.rc.in → build/updater.rc.
// Только VERSIONINFO (Слой A5): апдейтер для AV-эвристики выглядит как «дроппер, переписывающий
// программу» — заполненные метаданные издателя/версии снижают false-positive (особенно под Themida).
// Иконки нет: RpUpdater headless (WIN32, без окна).
#include <windows.h>

VS_VERSION_INFO VERSIONINFO
 FILEVERSION    @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 PRODUCTVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 FILEFLAGSMASK  0x3fL
 FILEFLAGS      0x0L
 FILEOS         VOS_NT_WINDOWS32
 FILETYPE       VFT_APP
 FILESUBTYPE    VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "TurgovBot"
            VALUE "FileDescription",  "RP Overlay Updater"
            VALUE "FileVersion",      "@PROJECT_VERSION@.0"
            VALUE "InternalName",     "RpUpdater"
            VALUE "OriginalFilename", "RpUpdater.exe"
            VALUE "ProductName",      "RP Overlay"
            VALUE "ProductVersion",   "@PROJECT_VERSION@"
            VALUE "LegalCopyright",   "Copyright (C) 2026 TurgovBot"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
